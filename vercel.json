{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/battles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/daily", "destination": "/?mode=daily", "permanent": false },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/:lang(fr|es)/blog", "destination": "/", "permanent": true },
    { "source": "/:lang(fr|es)/blog/:path*", "destination": "/", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.battleguess.app" }],
      "destination": "https://battleguess.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.battleguess.app" }],
      "destination": "https://battleguess.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/battles/:path*", "destination": "/index.html" },
    { "source": "/collections/:path*", "destination": "/index.html" },
    { "source": "/modes/:path*", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/fr/:path*", "destination": "/index.html" },
    { "source": "/es/:path*", "destination": "/index.html" },
    { "source": "/fr", "destination": "/index.html" },
    { "source": "/es", "destination": "/index.html" }
  ]
}
