{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/battles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/battles/:path*", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/collections/:path*", "destination": "/index.html" },
    { "source": "/modes/:path*", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/fr/:path*", "destination": "/index.html" },
    { "source": "/es/:path*", "destination": "/index.html" },
    { "source": "/fr", "destination": "/index.html" },
    { "source": "/es", "destination": "/index.html" }
  ]
}
